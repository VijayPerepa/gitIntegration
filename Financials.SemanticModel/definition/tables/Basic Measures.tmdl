table 'Basic Measures'
	lineageTag: 518d07b2-ae7a-46a2-8797-91721cb60a97

	measure 'Actual ''M' =
			
			VAR Revenue = CALCULATE(
			                    SUM(Financial_Data[Value]),
			                    Financial_Data[Actual/Budget] ="Actual",
			                    Financial_Categories[Category]="Revenue")
			VAR Expenses = CALCULATE(
			                    SUM(Financial_Data[Value]),
			                    Financial_Data[Actual/Budget] ="Actual",
			                    Financial_Categories[Category]="Expenses") *-1
			RETURN
			DIVIDE(Revenue+Expenses , 10^6,0)
		lineageTag: 74b1c5a8-e31a-4bd5-b8a3-62931f332bfe

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Budget ''M' =
			
			VAR Revenue = CALCULATE(
			                    SUM(Financial_Data[Value]),
			                    Financial_Data[Actual/Budget] ="Budget",
			                    Financial_Categories[Category]="Revenue")
			VAR Expenses = CALCULATE(
			                    SUM(Financial_Data[Value]),
			                    Financial_Data[Actual/Budget] ="Budget",
			                    Financial_Categories[Category]="Expenses") *-1
			RETURN
			DIVIDE(Revenue+Expenses , 10^6,0)
		lineageTag: 85c1c97b-09fa-4789-b463-ffe4ea63459a

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'LY Actual ''M' =
			
			CALCULATE(
			    [Actual 'M],
			    SAMEPERIODLASTYEAR(Dates[Date]))
		lineageTag: 144a80aa-1242-4124-88ec-bd962b882870

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Diff %' = ```
			
			 VAR Act_LY = DIVIDE([Actual 'M] - [LY Actual 'M],[LY Actual 'M],0)
			 VAR Act_Budget = DIVIDE([Actual 'M]-[Budget 'M],[Budget 'M],0)
			 var Selection = SELECTEDVALUE('Grouping'[Segment])
			 RETURN
			 IF(
			    Selection = "vs Last Year", Act_LY, Act_Budget)
			```
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 1653daa8-23ef-47aa-9153-84a20a08145b

	measure Title = ```
			
			"Financials for " & 
			SELECTEDVALUE(Dates[FY]) &
			" - Actual " & 
			SELECTEDVALUE('Grouping'[Segment])
			```
		lineageTag: 0dc43306-9095-42e3-9c41-267bf600843e

	measure 'Test Message' = "Test"
		lineageTag: 35b6e106-0c9d-49c0-afa3-34537d8e755a

	partition 'Basic Measures' = m
		mode: import
		source =
				let
				  Source = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("i44FAA==", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [Column1 = _t]),
				    #"Removed Columns" = Table.RemoveColumns(Source,{"Column1"})
				in
				  #"Removed Columns"

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

