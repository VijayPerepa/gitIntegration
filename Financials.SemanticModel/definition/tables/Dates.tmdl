		annotation SummarizationSetBy = Automatic

	partition Dates = calculated
		mode: import
		source = ```
				
				GENERATE(
				    CALENDARAUTO(3),
				    VAR D = [Date]
				    VAR MN = MONTH(D) VAR M = FORMAT(d,"MMM") 
				    VAR QN = QUARTER(D) var Q = "Q" & QN
				    Var FMN = IF(MN<4,mn+9,mn-3) var FQ = "Q" & ROUNDUP(fmn/3,0)
				    var Y = YEAR(D)
				    VAR FYR = IF(MN<4, "FY " & Y-1 & "-" & RIGHT(y,2),
				                       "FY " & Y & "-" & RIGHT(Y+1,2))
				RETURN
				ROW("Month",M, "Month No",MN, "Quarter",Q,"Year",Y,"Fiscal Month",FMN,
				"Fqtr",FQ,"FY",FYR))
				
				```

	annotation PBI_Id = 4fc3ee6e3fc3442a830ec40d0ed0cdef

